{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{js,css}", "/media/*", "/*.svg", "/*.png", "/*.ico", "/*.txt"]
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
  },
  "routes": [
    {
      "route": "/plumcast.apk",
      "redirect": "https://github.com/hrvojehorvat/mrvoje/releases/latest/download/plumcast.apk",
      "statusCode": 302
    },
    {
      "route": "/*.{js,css}",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/media/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "no-cache" }
    }
  ]
}
